{
  "name": "sirusita-wails-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "dev",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },

  // --- Docker 前提の設定 ---
  // updateRemoteUserUID: Linux ホストでは dev ユーザーの UID/GID をホストユーザーに合わせ、
  //   バインドマウントしたファイルの所有権ズレ（root 所有の生成物）を防ぐ。
  "updateRemoteUserUID": true,

  "containerUser": "dev",
  "remoteUser": "dev",

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  "containerEnv": {
    // コンテナがサンドボックスであることを Claude Code に明示する
    "IS_SANDBOX": "1"
  },

  // 生成直後の健全性チェック（失敗しても継続）
  "postCreateCommand": "wails doctor || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "golang.go"
      ]
    }
  }
}
